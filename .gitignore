# Build output
build

# Debug artifacts. Not *.txt: the vector and golden files are .txt, and a
# blanket ignore would swallow a fixture with git status staying clean.
*.gdb

# IDE / CTest run output (not used by project Makefile)
Testing

# Third-party / reference source trees (not tracked by name)
third_party

# Documentation generated by Doxygen
docs

# Example output files
example.output.*

# Task documents
tasks

# Test output (e.g. PNGs written by encode tests for verification)
tests/out

# Stray output under test data (use tests/out instead)
tests/data/out


# Pycache files (for generated test fixtures, in any directory)
**/__pycache__

# libFuzzer's artifacts. It writes them into the working directory - which for
# `make fuzz-run-*` is the repository root - with these exact prefixes, and one
# of them turned up in `git status` after the first run of a new harness. Named
# by prefix rather than ignored wholesale: an artifact worth keeping is worth
# committing under a name of its own, and the corpus itself lives under build/.
crash-*
leak-*
timeout-*
oom-*
