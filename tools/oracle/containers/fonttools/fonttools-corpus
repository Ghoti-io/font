#!/usr/bin/env python3
"""The corpus lists: which fonts in this image a differential covers.

A list in the image rather than a glob in each differential, so that "which
fonts did that run cover" has one answer and adding a package is one edit.

**The selection is by content, and this is the only place that decides it.**
With no `--require`, every sfnt under the roots; with one, every sfnt whose
table directory carries all the named tags. `fonttools-corpus-ebdt` is a
two-line wrapper that passes `--require EBLC,EBDT`, and the reason it is a
wrapper rather than a second program is the defect this file is the fix for -
see below.

Four things this does *not* do, and each cost something:

  * **It does not select by file extension.** The sfnt list matched `*.ttf`,
    `*.otf`, `*.ttc` and `*.otc`, and the bitmap-only sfnts Debian ships are
    named `.otb` - so the one shape in the population that is *nothing but*
    embedded strikes was the one shape the sfnt corpus could not see. Five files
    of the 490 in this image, which is 1%, and they are 100% of that shape. The
    same mistake in the same spelling made an earlier survey of Debian report two
    strike-carrying fonts where there are thirty-three. An sfnt says what it is
    in its first four bytes; a filename is a convention, and the format is the
    thing being selected for.

  * **It does not keep two copies of that decision.** The EBDT list was given
    content selection first and the sfnt list kept its glob, so for a while this
    image answered "what is an sfnt" two different ways depending on which
    differential asked. One walk, one magic test, one dedupe, and `--require` is
    the only thing that varies.

  * **It does not open a font with fontTools.** The table directory is read with
    struct, here, because the population must not be chosen by either reader
    being compared. fontTools cannot parse mona.ttf's EBLC at all
    (fonttools#317) and mona.ttf is precisely the font the EBDT corpus exists to
    name: a selector that asked the reference whether it could read a font would
    drop the only case where the two readers disagree about whether the font is
    readable.

  * **It does not glob the font tree and trust the paths.** Debian's alternatives
    put /usr/share/fonts/truetype/fonts-japanese-gothic.ttf beside mona.ttf as a
    symlink to it, so a list keyed on paths reports two fonts where there is one
    and every count downstream is wrong by one. `find -type f` already drops a
    symlink, and the realpath dedupe below is the check that says so rather than
    the assumption that it does.

PCF and the Type 1 fonts are *not* in any list here: they are not sfnts, so the
magic test excludes them without a name to exclude - which is the other half of
what content selection buys. `fonttools-corpus-bitmap` lists the PCF files for
phase 1b, and nothing reads them yet.
"""

import os
import struct
import subprocess
import sys

# What an sfnt's first four bytes may be. `true` and `typ1` are Apple's, `ttcf`
# is a collection, and `OTTO` carries CFF outlines - a `.otb` is 0x00010000 like
# any other TrueType-flavoured sfnt, which is the point: nothing about the shape
# announces itself in the name.
MAGIC = (b"\x00\x01\x00\x00", b"true", b"typ1", b"OTTO", b"ttcf")


def tags(data, offset):
    """The four-character tags of one sfnt's table directory."""
    if offset + 12 > len(data):
        return set()
    count = struct.unpack(">H", data[offset + 4:offset + 6])[0]
    found = set()
    for index in range(count):
        at = offset + 12 + 16 * index
        if at + 4 > len(data):
            break
        found.add(data[at:at + 4])
    return found


def faces(data):
    """Where each face's table directory starts, or None if this is not an sfnt.

    None rather than an empty list, because "not an sfnt" and "an sfnt with no
    faces" are different answers and a caller testing truthiness would merge
    them. The magic is checked before any offset in the file is believed:
    without it this reads a table count out of bytes 4 and 5 of *any* file it is
    handed - a PNG, a README - and collects whatever four-byte sequences follow,
    which can match a tag by accident. Selection by content means every regular
    file under the roots arrives here, so this check carries weight it did not
    when a glob had already decided.
    """
    if data[:4] not in MAGIC:
        return None
    if data[:4] != b"ttcf":
        return [0]
    if len(data) < 12:
        return []
    count = struct.unpack(">I", data[8:12])[0]
    offsets = []
    for index in range(count):
        at = 12 + 4 * index
        if at + 4 > len(data):
            break
        offsets.append(struct.unpack(">I", data[at:at + 4])[0])
    return offsets


def selected(path, require):
    """Whether this file is an sfnt, and carries @p require on some face.

    Per *face* and not per file: `uming.ttc` carries strikes on four of its six
    faces, and a collection whose fifth face happens to lack a table is still a
    file the differential must read. `require` empty selects every sfnt.
    """
    try:
        with open(path, "rb") as handle:
            data = handle.read()
    except OSError:
        return False
    found = faces(data)
    if found is None:
        return False
    if not require:
        return True
    return any(all(tag in tags(data, offset) for tag in require)
               for offset in found)


def main(argv):
    """Every selected font under the roots, one per line.

    The roots are arguments so that this is the only implementation of "which
    fonts": `eblc_diff.py` runs the EBDT wrapper over the image's fonts through
    corpus.py *and* over `tests/data/fonts` directly, and a fixture that stops
    being a strike fixture - or a new one that starts - changes what that
    differential compares without anybody editing a second list.
    """
    require = []
    roots = []
    rest = list(argv)
    while rest:
        argument = rest.pop(0)
        if argument == "--require":
            if not rest:
                sys.stderr.write("fonttools-corpus: --require needs tags\n")
                return 2
            require = [tag.encode("ascii") for tag in rest.pop(0).split(",")
                       if tag]
            # A tag is four bytes in the file. A `--require glyf2` that silently
            # matched nothing would report an empty corpus, and an empty corpus
            # is what a differential reads as "nothing to disagree about".
            for tag in require:
                if len(tag) != 4:
                    sys.stderr.write(
                        "fonttools-corpus: %r is not a four-byte tag\n"
                        % tag.decode("ascii"))
                    return 2
        elif argument.startswith("--"):
            sys.stderr.write("fonttools-corpus: unknown option %s\n" % argument)
            return 2
        else:
            roots.append(argument)

    finished = subprocess.run(["find"] + (roots or ["/usr/share/fonts"])
        + ["-type", "f"], capture_output=True, text=True, check=True)
    seen = set()
    found = []
    for path in finished.stdout.split("\n"):
        if not path:
            continue
        real = os.path.realpath(path)
        if real in seen:
            continue
        seen.add(real)
        if selected(real, require):
            found.append(real)
    for path in sorted(found):
        print(path)
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
