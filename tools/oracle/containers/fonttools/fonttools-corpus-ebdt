#!/bin/sh
# The EBDT corpus: every sfnt in this image with embedded bitmap strikes.
#
# A list of its own, like fonttools-corpus-bitmap, because thirty-three fonts of
# the image's 490 have this table and mixing them into the sfnt corpus would make
# eblc_diff's denominator mostly files it skipped.
#
# Two tags and not one, because neither names a glyph without the other - the
# same rule the library applies in gfnt_face_has_eblc().
#
# A wrapper and not a program, because it used to be a program and that is how
# the two corpus lists came to disagree about what an sfnt is: this one was given
# selection by content, the sfnt list kept its extension glob, and for a while
# the answer depended on which differential asked. fonttools-corpus holds the
# walk, the magic test and the dedupe; this file holds only the tags.
exec fonttools-corpus --require EBLC,EBDT "$@"
